<beans xmlns="http://www.springframework.org/schema/beans"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://www.springframework.org/schema/beans
http://www.springframework.org/schema/beans/spring-beans-2.5.xsd">
	
    <bean
       class="org.springframework.beans.factory.config.PropertyPlaceholderConfigurer">
       <property name="location">
          <value>servicio.properties</value>
       </property>
    </bean>
 
    <bean id="servicioPropiedades" class="dominio.BDMySql">
      <property name="urlBD" value="${urlBD}" />
      <property name="user" value="${user}" />
      <property name="password" value="${password}" />
    </bean>

    <bean id="dataSource" class="org.springframework.jdbc.datasource.DriverManagerDataSource">
      <property name="driverClassName" value="${driverClassName}" />
      <property name="url" value="${urlBD}" />
      <property name="username" value="${user}" />
      <property name="password" value="${password}" />
    </bean>

    <bean id="usuariosJDBCTemplate" class="baseDeDatos.UsuariosJDBCTemplate">
      <property name="dataSource" ref="dataSource" />
    </bean>
</beans>
